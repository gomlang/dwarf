package tests;

use ecosystem::dwarf;
use dwarf::{Sections, Endian, Limits};
use std::bytes;
use std::testing;

fn little(data: bytes::Bytes, value: isize, width: isize) -> () {
    for index in 0..width {
        data.push((value >> (index * 8)).to_u8());
    }
}

fn line_sections(version: isize) -> Sections {
    let mut sections = Sections::empty();
    sections.info = bytes::Bytes::from_vec(
        Vec::from_array([12, 0, 0, 0, 4, 0, 0, 0, 0, 0, 8, 1, 0, 0, 0, 0]),
    );
    sections.abbrev = bytes::Bytes::from_vec(Vec::from_array([1, 17, 0, 16, 23, 0, 0, 0]));
    let header = bytes::Bytes::from_vec(
        Vec::from_array([2, 3, 1, 0, 1, 13, 0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]),
    );
    if version == 4 {
        header.extend_from_slice(
            bytes::Bytes::from_vec(Vec::from_array([0, b'a', 0, 0, 0, 0, 0])).as_slice(),
        );
    } else {
        header.extend_from_slice(
            bytes::Bytes::from_vec(
                Vec::from_array([1, 1, 8, 1, b'.', 0, 2, 1, 8, 2, 15, 2, b'a', 0, 0, b'b', 0, 0]),
            ).as_slice(),
        );
    }
    let body = bytes::Bytes::new();
    little(body, version, 2);
    if version == 5 {
        body.push(8);
        body.push(0);
    }
    little(body, header.len(), 4);
    body.extend_from_slice(header.as_slice());
    body.extend_from_slice(
        bytes::Bytes::from_vec(
            Vec::from_array(
                [
                    12,
                    7,
                    7,
                    10,
                    11,
                    0,
                    2,
                    4,
                    9,
                    2,
                    1,
                    1,
                    1,
                    7,
                    10,
                    11,
                    0,
                    2,
                    4,
                    9,
                    14,
                    14,
                    7,
                    0,
                    2,
                    4,
                    3,
                    0,
                    1,
                    1,
                    1,
                    2,
                    2,
                    9,
                    5,
                    0,
                    1,
                    0,
                    1,
                    1,
                ],
            ),
        ).as_slice(),
    );
    little(sections.line, body.len(), 4);
    sections.line.extend_from_slice(body.as_slice());
    sections
}

#[test]
fn line_rows_preserve_operation_positions_and_register_lifetimes() -> () {
    for version in Vec::from_array([4, 5]) {
        let data = testing::expect_ok(
            dwarf::parse_sections_detailed(
                line_sections(version),
                Endian::Little,
                Limits::standard(),
            ),
            "line state",
        );
        let rows = data.line_tables[0].rows;
        testing::assert_eq(rows.len(), 8);
        for index in Vec::from_array([0, 2]) {
            let row = rows[index];
            testing::assert(row.basic_block && row.prologue_end && row.epilogue_begin);
            testing::assert_eq(row.discriminator, 9);
            testing::assert_eq(row.isa, 7);
        }
        for index in Vec::from_array([1, 3, 5, 6, 7]) {
            let row = rows[index];
            testing::assert(!row.basic_block && !row.prologue_end && !row.epilogue_begin);
            testing::assert_eq(row.discriminator, 0);
        }
        testing::assert_eq(rows[0].row.address, 0);
        testing::assert_eq(rows[0].op_index, 1);
        testing::assert_eq(rows[2].op_index, 2);
        testing::assert_eq(rows[3].row.address, 2);
        testing::assert_eq(rows[3].op_index, 0);
        testing::assert_eq(rows[3].isa, 7);
        testing::assert(rows[4].row.end_sequence && rows[4].basic_block);
        testing::assert_eq(rows[4].discriminator, 3);
        testing::assert_eq(rows[4].isa, 7);
        testing::assert_eq(rows[5].row.address, 0);
        testing::assert_eq(rows[5].op_index, 0);
        testing::assert_eq(rows[5].isa, 0);
        testing::assert_eq(rows[6].row.address, 5);
        testing::assert_eq(rows[6].op_index, 0);
        testing::assert(rows[7].row.end_sequence);
    }
}

#[test]
fn original_line_records_and_parse_entry_point_remain_compatible() -> () {
    let original = dwarf::LineRow {
        address: 0,
        file: 1,
        line: 1,
        column: 0,
        is_stmt: true,
        end_sequence: false,
    };
    let table = dwarf::LineTable {
        offset: 0,
        version: 4,
        files: Vec::from_array(["", "a"]),
        rows: Vec::from_array([original]),
    };
    let data = dwarf::Data { units: Vec::new(), line_tables: Vec::from_array([table]) };
    testing::assert(data.line_tables[0].rows[0] == original);
    for version in Vec::from_array([4, 5]) {
        let sections = line_sections(version);
        let legacy = testing::expect_ok(
            dwarf::parse_sections(sections, Endian::Little, Limits::standard()),
            "original API",
        );
        let detailed = testing::expect_ok(
            dwarf::parse_sections_detailed(sections, Endian::Little, Limits::standard()),
            "detailed API",
        );
        testing::assert_eq(legacy.units.len(), detailed.units.len());
        testing::assert_eq(legacy.line_tables.len(), detailed.line_tables.len());
        testing::assert(legacy.line_tables[0].rows[0] == original);
        for index in 0..legacy.line_tables.len() {
            let left = legacy.line_tables[index];
            let right = detailed.line_tables[index];
            testing::assert_eq(left.offset, right.offset);
            testing::assert_eq(left.version, right.version);
            testing::assert_eq(left.files.len(), right.files.len());
            for file in 0..left.files.len() {
                testing::assert_eq(left.files[file], right.files[file]);
            }
            testing::assert_eq(left.rows.len(), right.rows.len());
            for row in 0..left.rows.len() {
                testing::assert(left.rows[row] == right.rows[row].row);
            }
        }
        let mut limits = Limits::standard();
        limits.max_line_rows = 1;
        let legacy_error = testing::expect_err(
            dwarf::parse_sections(sections, Endian::Little, limits),
            "original limit",
        );
        let detailed_error = testing::expect_err(
            dwarf::parse_sections_detailed(sections, Endian::Little, limits),
            "detailed limit",
        );
        testing::assert_eq(legacy_error, detailed_error);
    }
}
